@model ErrorViewModel
@{
    ViewData["Title"] = "Something Went Wrong";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 text-center">
                <h2 class="fw-bold text-danger mb-2">Oops! Something Went Wrong</h2>
                <p class="text-muted mb-4">
                    We couldn't complete that request cleanly. Please check your input values or try again in a moment.
                </p>

                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted mb-4">
                        Reference ID: <code>@Model.RequestId</code>
                    </p>
                }

                <a asp-controller="Home" asp-action="Index" class="btn btn-primary fw-semibold px-4">
                    Return to Events
                </a>
            </div>
        </div>
    </div>
</div>