@model RaceDay.Web.Controllers.EventResultsViewModel
@{
    ViewData["Title"] = "Capture Results";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0">Results Entry — @Model.EventName</h2>
        <p class="text-muted mb-0">Record or update finish times (hh:mm:ss) and finishing positions.</p>
    </div>
    <a asp-action="Events" class="btn btn-outline-secondary">Back to Events</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @if (!Model.Entries.Any())
        {
            <p class="text-muted mb-0">No enrolled participants available for results entry.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Participant</th>
                            <th>Category</th>
                            <th>Finish Time (hh:mm:ss)</th>
                            <th>Position</th>
                            <th>Status</th>
                            <th class="text-end">Save</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Entries)
                        {
                            <tr>
                                <td class="fw-semibold">@row.ParticipantName</td>
                                <td>@row.CategoryName</td>
                                <td colspan="4">
                                    <form asp-action="SaveResult" method="post" class="row g-2 align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="eventId" value="@Model.EventId" />
                                        <input type="hidden" name="enrolmentId" value="@row.EnrolmentId" />
                                        <div class="col-md-4">
                                            <input type="text" name="finishTimeText" value="@row.FinishTimeText" class="form-control form-control-sm" placeholder="00:45:12" required />
                                        </div>
                                        <div class="col-md-3">
                                            <input type="number" name="position" value="@row.Position" min="1" class="form-control form-control-sm" required />
                                        </div>
                                        <div class="col-md-2">
                                            @if (row.AlreadyRecorded)
                                            {
                                                <span class="badge bg-success">Published</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Pending</span>
                                            }
                                        </div>
                                        <div class="col-md-3 text-end">
                                            <button type="submit" class="btn btn-sm btn-primary">Save Result</button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>