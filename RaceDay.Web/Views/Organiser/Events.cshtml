@model List<RaceDay.Web.Controllers.EventSummaryItem>
@{
    ViewData["Title"] = "Manage Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Manage Events</h2>
        <p class="text-muted mb-0">Create, edit, or remove your race events.</p>
    </div>
    <a asp-action="CreateEvent" class="btn btn-warning fw-semibold">+ New Event</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted mb-0">No events found for your account.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Banner</th>
                            <th>Name</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Distance</th>
                            <th class="text-end">Manage</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var evt in Model)
                        {
                            <tr>
                                <td style="width: 90px;">
                                    @if (!string.IsNullOrWhiteSpace(evt.BannerUrl))
                                    {
                                        <img src="@evt.BannerUrl" alt="@evt.Name" class="img-thumbnail" style="width: 76px; height: 48px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No Banner</span>
                                    }
                                </td>
                                <td class="fw-semibold">@evt.Name</td>
                                <td>@evt.Date.ToString("yyyy-MM-dd")</td>
                                <td>@evt.Location</td>
                                <td>@evt.DistanceKm km</td>
                                <td class="text-end">
                                    <a asp-action="EditEvent" asp-route-id="@evt.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Categories" asp-route-id="@evt.Id" class="btn btn-sm btn-outline-secondary">Categories</a>
                                    <a asp-action="Enrolments" asp-route-id="@evt.Id" class="btn btn-sm btn-outline-info">Enrolments</a>
                                    <a asp-action="Results" asp-route-id="@evt.Id" class="btn btn-sm btn-outline-success">Results</a>
                                    <form asp-action="DeleteEvent" asp-route-id="@evt.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this event?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>