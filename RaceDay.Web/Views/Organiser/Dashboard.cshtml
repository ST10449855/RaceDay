@model RaceDay.Web.Controllers.OrganiserDashboardViewModel
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Organiser Dashboard</h2>
        <p class="text-muted mb-0">Overview of your events, enrolments, and upcoming race schedule.</p>
    </div>
    <a asp-action="CreateEvent" class="btn btn-warning fw-semibold">+ Create Event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">My Total Events</div>
                <div class="fs-2 fw-bold">@Model.TotalEvents</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Upcoming Events</div>
                <div class="fs-2 fw-bold text-primary">@Model.UpcomingEventsCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Total Enrolments</div>
                <div class="fs-2 fw-bold text-success">@Model.TotalEnrolmentsAcrossEvents</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h5 class="fw-bold mb-3">Your Events</h5>
        @if (!Model.Events.Any())
        {
            <p class="text-muted mb-0">You haven't created any events yet. Click <strong>+ Create Event</strong> to get started.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Categories</th>
                            <th>Enrolments</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Events)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Name</td>
                                <td>@item.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@item.Location</td>
                                <td><span class="badge bg-info text-dark">@item.CategoryCount</span></td>
                                <td><span class="badge bg-primary">@item.TotalEnrolments</span></td>
                                <td class="text-end">
                                    <a asp-action="Categories" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-secondary">Categories</a>
                                    <a asp-action="Enrolments" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-primary">Enrolments</a>
                                    <a asp-action="Results" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-success">Results</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>