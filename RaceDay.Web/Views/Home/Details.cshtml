@model RaceDay.Web.Controllers.EventSummaryItem
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = Model.Name;
    var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
    string TypeLabel(int t) => t switch { 0 => "Run", 1 => "Walk", 2 => "Cycle", _ => "Event" };
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to All Events</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card border-0 shadow-sm overflow-hidden">
    @if (!string.IsNullOrWhiteSpace(Model.BannerUrl))
    {
        <img src="@Model.BannerUrl" alt="@Model.Name" class="w-100" style="max-height: 340px; object-fit: cover;" />
    }
    <div class="card-body p-4">
        <div class="d-flex flex-wrap gap-2 mb-2">
            <span class="badge bg-warning text-dark fs-6">@TypeLabel(Model.Type)</span>
            <span class="badge bg-primary fs-6">@Model.DistanceKm km</span>
        </div>

        <h1 class="fw-bold mb-2">@Model.Name</h1>
        <p class="text-muted mb-3">
            <strong>Date &amp; Time:</strong> @Model.Date.ToString("dddd, dd MMMM yyyy 'at' HH:mm") &nbsp;|&nbsp;
            <strong>Location:</strong> @Model.Location
        </p>

        <p class="lead fs-6 mb-4">@Model.Description</p>

        <hr />

        <h4 class="fw-bold mb-3">Available Categories &amp; Race Entry</h4>
        @if (Model.Categories == null || !Model.Categories.Any())
        {
            <div class="alert alert-warning mb-0">No race categories have been published for this event yet.</div>
        }
        else if (userId != null && string.Equals(userRole, "Participant", StringComparison.OrdinalIgnoreCase))
        {
            <form asp-controller="Participant" asp-action="Enrol" method="post" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="eventId" value="@Model.Id" />

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Select Your Race Category</label>
                    <select name="categoryId" class="form-select" required>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id">@cat.Name (Ages @cat.MinAge – @cat.MaxAge)</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <button type="submit" class="btn btn-success w-100 fw-semibold py-2">Enter Event Now</button>
                </div>
            </form>
        }
        else if (userId == null)
        {
            <div class="alert alert-info mb-0">
                Please <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Home", new { id = Model.Id })" class="fw-semibold">log in as a Participant</a> to enter this event.
            </div>
        }
        else
        {
            <div class="alert alert-secondary mb-0">You are signed in as an Organiser. Switch to a Participant account to enrol in races.</div>
        }
    </div>
</div>