@model RaceDay.Web.Controllers.UserProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="fw-bold mb-1">Athlete Profile</h2>
                <p class="text-muted mb-4">View and update your personal details and profile photo.</p>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="d-flex align-items-center gap-3 mb-4">
                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="Profile Picture" class="rounded-circle border" style="width: 84px; height: 84px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-dark text-warning d-flex align-items-center justify-content-center fw-bold fs-3" style="width: 84px; height: 84px;">
                            @(string.IsNullOrWhiteSpace(Model.Name) ? "R" : Model.Name[0].ToString().ToUpper())
                        </div>
                    }
                    <div>
                        <h5 class="fw-bold mb-0">@Model.Name</h5>
                        <div class="text-muted small">@Model.Email</div>
                        <span class="badge bg-primary mt-1">@Model.Role</span>
                    </div>
                </div>

                <form asp-action="Profile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Role" />
                    <input type="hidden" asp-for="ProfilePictureUrl" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Full Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <input value="@Model.Email" class="form-control" disabled />
                    </div>

                    <div class="mb-4">
                        <label asp-for="ProfilePictureFile" class="form-label fw-semibold">Upload New Profile Picture (Azure Blob Storage)</label>
                        <input asp-for="ProfilePictureFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
                        <span asp-validation-for="ProfilePictureFile" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary fw-semibold px-4">Save Profile</button>
                </form>
            </div>
        </div>
    </div>
</div>